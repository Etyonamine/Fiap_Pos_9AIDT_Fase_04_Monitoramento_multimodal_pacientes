AZURE_SPEECH_KEY=sua_chave_speech
AZURE_SPEECH_REGION=eastus
AZURE_LANGUAGE_KEY=sua_chave_language
AZURE_LANGUAGE_ENDPOINT=https://seu-recurso.cognitiveservices.azure.com
# Os nomes AZURE_TEXT_ANALYTICS_KEY e AZURE_TEXT_ANALYTICS_ENDPOINT tambem sao aceitos.
# FHIR R4 pode ser consultado manualmente ou enviar Bundles de assinatura ao fluxo autenticado.
# Configure URL HTTPS e token no backend; nao coloque credenciais no repositorio.
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=
# Token independente para produtores HTTP/FHIR; gere um segredo de ao menos 32 caracteres.
CLINICAL_INGEST_BEARER_TOKEN=
# Webhook opcional: envia alertas de midia confirmados e eventos clinicos para revisao.
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_BEARER_TOKEN=
YOLO_MODEL_PATH=models/yolov8n-pose.pt
# Caminhos relativos sao resolvidos a partir de backend, nao da pasta do terminal.
